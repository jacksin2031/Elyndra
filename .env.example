# OpenAI-compatible Chat Completions endpoint
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Optional server AI routes are disabled until an explicit bearer token is configured.
ELYNDRA_SERVER_TOKEN=
ELYNDRA_MAX_REQUEST_BYTES=49152
# Mandatory on Vercel/serverless: shared, atomic rate limit storage (local dev uses in-memory limits).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ELYNDRA_RATE_LIMIT_PER_MINUTE=30

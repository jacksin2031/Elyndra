# OpenAI-compatible Chat Completions endpoint
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Server AI gateway is disabled unless explicitly enabled.
# Browser Direct/BYOK mode does not need these server gateway settings.
ELYNDRA_SERVER_AI_ENABLED=false

# Required when ELYNDRA_SERVER_AI_ENABLED=true.
# Keep this secret on a trusted server/reverse proxy; do not ship it in browser JavaScript.
ELYNDRA_GATEWAY_TOKEN=

# Optional comma-separated browser origins allowed in addition to exact same-origin requests.
ELYNDRA_ALLOWED_ORIGINS=

# Request safety limits.
ELYNDRA_MAX_REQUEST_BYTES=524288
ELYNDRA_RATE_LIMIT_PER_MINUTE=30
ELYNDRA_WORLD_RATE_LIMIT_PER_MINUTE=4

     const lockedReason=x=>({OTHER_PATH_LOCKED:"其他成長路線的進階能力已鎖定",PREVIOUS_TIER_REQUIRED:"要先走完前一階段",NO_TALENT_POINT:"目前天賦點不足"})[x.reason]||"暫時無法選擇";

     if(stage==="RUNTIME_SOCIETY")return {...empty,factions:generation?.factions||[]};
     if(stage==="RUNTIME_CAST")return {...empty,npcs:generation?.npcs||[]};
     if(stage==="RUNTIME_QUESTS")return {...empty,sideQuests:generation?.sideQuests||[]};

     <div class="lore-item"><small>KNOWN FACTIONS</small><p>${factions.map(x=>`<strong>${esc(lt(x.name))}</strong> · ${esc(staticText("關係"))} ${x.playerReputation??0}<br><small>${esc(lt(x.goal||""))}</small>`).join("<br><br>")||"尚未確認勢力"}</p></div>
     </div>`);bindNpcLinks()

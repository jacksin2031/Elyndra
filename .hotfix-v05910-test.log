      targetPlayHours:Math.max(2,Math.min(100,Math.round(n("playHours")||15))),difficulty:v("difficulty"),originType:v("originType"),originCustom:v("originCustom"),playerRole:v("playerRole"),roleCustom:v("roleCustom"),

      setAIThinking(true,"AI 正在解析 Action Intent 並判斷必要前提…");
      try{assessment=await assessPlayerAction(actionState,requested);if(!isCurrentStateSession(actionSession))return}
      catch(e){
       console.warn("action feasibility failed",e);

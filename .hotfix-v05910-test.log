     for(const target of ["required","allowed","forbidden"])creatorField(target+"TagInput")?.addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();addRuleTag(target,e.currentTarget.value);e.currentTarget.value=""}});

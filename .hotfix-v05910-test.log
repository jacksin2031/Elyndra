     ${regionHtml||'<div class="lore-item"><p>尚未掌握任何可定位的地點。</p></div>'}
     <div class="lore-item"><small>KNOWN ROUTES</small><p>${routeByRegion.length?routeByRegion.join("<br>"):"尚未確認地點之間的路線"}</p></div>
